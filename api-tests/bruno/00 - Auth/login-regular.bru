meta {
  name: Login as Regular User
  type: http
  seq: 9
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: text
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded; charset=UTF-8
}

body:text {
  grant_type=password&client_id={{client_id}}&client_secret={{client_secret}}&username={{regular_user}}&password={{regular_password}}
}

script:post-response {
  // CLI workaround: @usebruno/cli drops `body:form-urlencoded` bodies (mode
  // mismatch); charset suffix keeps interpolation of text bodies working.
  const data = res.getBody();
  bru.setVar("regular_token", data.access_token);
}
