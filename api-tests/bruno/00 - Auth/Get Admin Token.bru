meta {
  name: Get Keycloak Admin Token
  type: http
  seq: 2
}

post {
  url: {{keycloak_url}}/realms/master/protocol/openid-connect/token
  body: text
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded; charset=UTF-8
}

body:text {
  grant_type=password&client_id=admin-cli&username={{kc_admin_user}}&password={{kc_admin_password}}
}

script:post-response {
  // CLI workaround: @usebruno/cli drops `body:form-urlencoded` bodies (mode
  // mismatch); charset suffix keeps interpolation of text bodies working.
  const data = res.getBody();
  bru.setVar("kc_token", data.access_token);
}
