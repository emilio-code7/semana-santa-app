meta {
  name: Define Cruceta (Admin only)
  type: http
  seq: 21
}

put {
  url: {{base_url}}/api/hermandades/{{hermandad_id}}/procesiones/{{procesion_id}}/cruceta
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "items": [
      {
        "marchaId": "{{marcha_id}}",
        "orderIndex": 1,
        "notes": "Opening marcha"
      }
    ]
  }
}
